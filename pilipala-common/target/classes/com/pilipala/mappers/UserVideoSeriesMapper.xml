<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.pilipala.mappers.UserVideoSeriesMapper">
    <!--实体映射-->
    <resultMap id="base_result_map" type="com.pilipala.entity.po.UserVideoSeries">
        <!--列表ID-->
        <id column="series_id" property="seriesId"/>
        <!--列表名称-->
        <result column="series_name" property="seriesName"/>
        <!--描述-->
        <result column="series_description" property="seriesDescription"/>
        <!--用户ID-->
        <result column="user_id" property="userId"/>
        <!--排序-->
        <result column="sort" property="sort"/>
        <!--更新时间-->
        <result column="update_time" property="updateTime"/>
    </resultMap>
    <!--通用查询结果列-->
    <sql id="base_column_list">
        series_id,series_name,series_description,user_id,sort,update_time
    </sql>

    <!--基础查询条件-->
    <sql id="base_query_condition">
        <if test="query.seriesId!=null">
            and series_id=#{query.seriesId}
        </if>
        <if test="query.seriesName!=null and query.seriesName!=''">
            and series_name=#{query.seriesName}
        </if>
        <if test="query.seriesDescription!=null and query.seriesDescription!=''">
            and series_description=#{query.seriesDescription}
        </if>
        <if test="query.userId!=null and query.userId!=''">
            and user_id=#{query.userId}
        </if>
        <if test="query.sort!=null">
            and sort=#{query.sort}
        </if>
        <if test="query.updateTime!=null">
            and update_time=#{query.updateTime}
        </if>
    </sql>
    <!--扩展查询条件-->
    <sql id="base_query_condition_extend">
        <if test="query.seriesNameFuzzy!=null and query.seriesNameFuzzy!=''">
            and series_name like concat('%',#{query.seriesNameFuzzy},'%')
        </if>
        <if test="query.seriesDescriptionFuzzy!=null and query.seriesDescriptionFuzzy!=''">
            and series_description like concat('%',#{query.seriesDescriptionFuzzy},'%')
        </if>
        <if test="query.userIdFuzzy!=null and query.userIdFuzzy!=''">
            and user_id like concat('%',#{query.userIdFuzzy},'%')
        </if>
        <if test="query.updateTimeStart!=null and query.updateTimeStart!=''">
            <![CDATA[ and  update_time >= str_to_date(#{query.updateTimeStart},'%Y-%m-%d') ]]>
        </if>
        <if test="query.updateTimeEnd!=null and query.updateTimeEnd!=''">
            <![CDATA[ and  update_time < date_sub(str_to_date(#{query.updateTimeEnd},'%Y-%m-%d'),interval -1 day) ]]>
        </if>
    </sql>
    <!--通用查询条件-->
    <sql id="query_condition">
        <where>
            <include refid="base_query_condition"/>
            <include refid="base_query_condition_extend"/>
        </where>
    </sql>
    <!--查询列表-->
    <select id="selectList" resultMap="base_result_map">
        SELECT
        <include refid="base_column_list"/>
        FROM user_video_series
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">order by ${query.orderBy}</if>
        <if test="query.simplePage!=null">limit #{query.simplePage.start},#{query.simplePage.end}</if>
    </select>
    <!--查询数量-->
    <select id="selectCount" resultType="java.lang.Integer">
        SELECT count(1) FROM user_video_series
        <include refid="query_condition"/>
    </select>
    <!--插入(匹配有值的字段)-->
    <insert id="insert" parameterType="com.pilipala.entity.po.UserVideoSeries">
        <selectKey keyProperty="bean.seriesId" resultType="Integer" order="AFTER">
            SELECT LAST_INSERT_ID();
        </selectKey>
        insert into user_video_series
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bean.seriesId!=null">
                series_id,
            </if>
            <if test="bean.seriesName!=null">
                series_name,
            </if>
            <if test="bean.seriesDescription!=null">
                series_description,
            </if>
            <if test="bean.userId!=null">
                user_id,
            </if>
            <if test="bean.sort!=null">
                sort,
            </if>
            <if test="bean.updateTime!=null">
                update_time,
            </if>
        </trim>
        <trim prefix="values(" suffix=")" suffixOverrides=",">
            <if test="bean.seriesId!=null">
                #{bean.seriesId},
            </if>
            <if test="bean.seriesName!=null">
                #{bean.seriesName},
            </if>
            <if test="bean.seriesDescription!=null">
                #{bean.seriesDescription},
            </if>
            <if test="bean.userId!=null">
                #{bean.userId},
            </if>
            <if test="bean.sort!=null">
                #{bean.sort},
            </if>
            <if test="bean.updateTime!=null">
                #{bean.updateTime},
            </if>
        </trim>
    </insert>
    <!--插入或者更新(匹配有值的字段)-->
    <insert id="insertOrUpdate" parameterType="com.pilipala.entity.po.UserVideoSeries">
        insert into user_video_series
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="bean.seriesId!=null">
                series_id,
            </if>
            <if test="bean.seriesName!=null">
                series_name,
            </if>
            <if test="bean.seriesDescription!=null">
                series_description,
            </if>
            <if test="bean.userId!=null">
                user_id,
            </if>
            <if test="bean.sort!=null">
                sort,
            </if>
            <if test="bean.updateTime!=null">
                update_time,
            </if>
        </trim>
        <trim prefix="values(" suffix=")" suffixOverrides=",">
            <if test="bean.seriesId!=null">
                #{bean.seriesId},
            </if>
            <if test="bean.seriesName!=null">
                #{bean.seriesName},
            </if>
            <if test="bean.seriesDescription!=null">
                #{bean.seriesDescription},
            </if>
            <if test="bean.userId!=null">
                #{bean.userId},
            </if>
            <if test="bean.sort!=null">
                #{bean.sort},
            </if>
            <if test="bean.updateTime!=null">
                #{bean.updateTime},
            </if>
        </trim>
        on DUPLICATE key update
        <trim prefix="" suffix="" suffixOverrides=",">
            <if test="bean.seriesName!=null">
                series_name =VALUES(series_name),
            </if>
            <if test="bean.seriesDescription!=null">
                series_description =VALUES(series_description),
            </if>
            <if test="bean.userId!=null">
                user_id =VALUES(user_id),
            </if>
            <if test="bean.sort!=null">
                sort =VALUES(sort),
            </if>
            <if test="bean.updateTime!=null">
                update_time =VALUES(update_time),
            </if>

        </trim>
    </insert>
    <!--添加(批量插入)-->
    <insert id="insertBatch" parameterType="com.pilipala.entity.po.UserVideoSeries">
        insert into user_video_series(series_name,series_description,user_id,sort,update_time)values
        <foreach collection="list" item="item" separator=",">
            (#{item.seriesName},#{item.seriesDescription},#{item.userId},#{item.sort},#{item.updateTime})
        </foreach>
    </insert>
    <!--批量插入或更新-->
    <insert id="insertOrUpdateBatch" parameterType="com.pilipala.entity.po.UserVideoSeries">
        insert into user_video_series(series_name,series_description,user_id,sort,update_time)values
        <foreach collection="list" item="item" separator=",">
            (#{item.seriesName},#{item.seriesDescription},#{item.userId},#{item.sort},#{item.updateTime})
        </foreach>
        on DUPLICATE key update
        series_id= VALUES(series_id),series_name= VALUES(series_name),series_description=
        VALUES(series_description),user_id= VALUES(user_id),sort= VALUES(sort),update_time= VALUES(update_time)
    </insert>
    <!-- 根据"SeriesId"查询-->
    <select id="selectBySeriesId" resultMap="base_result_map">
        select
        <include refid="base_column_list"/>
        from user_video_series where series_id=#{seriesId}
    </select>
    <!-- 根据"SeriesId"更新-->
    <update id="updateBySeriesId" parameterType="com.pilipala.entity.po.UserVideoSeries">
        update user_video_series
        <set>
            <if test="bean.seriesId!=null">
                series_id=#{bean.seriesId},
            </if>
            <if test="bean.seriesName!=null">
                series_name=#{bean.seriesName},
            </if>
            <if test="bean.seriesDescription!=null">
                series_description=#{bean.seriesDescription},
            </if>
            <if test="bean.userId!=null">
                user_id=#{bean.userId},
            </if>
            <if test="bean.sort!=null">
                sort=#{bean.sort},
            </if>
            <if test="bean.updateTime!=null">
                update_time=#{bean.updateTime},
            </if>
        </set>
        <where>
            series_id=#{seriesId}
        </where>
    </update>

    <!-- 根据"SeriesId"删除-->
    <delete id="deleteBySeriesId">
        delete
        from user_video_series
        where series_id = #{seriesId}
    </delete>

    <select id="selectUserAllSeries" resultMap="base_result_map">
        select t.*, v.video_cover as cover
        from (select *,
                     (select video_id
                      from user_video_series_video as v
                      where v.series_id = s.series_id
                      order by sort ASC
                      limit 1) video_id
              from user_video_series as s
              where s.user_id = #{userId}) t
                 left join video as v on v.video_id = t.video_id
        order by t.sort asc
    </select>

    <select id="selectMaxSort" resultType="java.lang.Integer">
        select ifnull(max(sort), 0)
        from user_video_series
        where user_id = #{userId}
    </select>

    <!-- 按条件动态更新（匹配有值的字段） -->
    <update id="updateByParam" parameterType="map">
        UPDATE user_video_series
        <set>
            <if test="bean.seriesName != null">
                series_name = #{bean.seriesName},
            </if>
            <if test="bean.seriesDescription != null">
                series_description = #{bean.seriesDescription},
            </if>
            <if test="bean.userId != null">
                user_id = #{bean.userId},
            </if>
            <if test="bean.sort != null">
                sort = #{bean.sort},
            </if>
            <if test="bean.updateTime != null">
                update_time = #{bean.updateTime},
            </if>
        </set>

        <where>
            <if test="query.seriesId != null">
                AND series_id = #{query.seriesId}
            </if>
            <if test="query.seriesName != null and query.seriesName != ''">
                AND series_name = #{query.seriesName}
            </if>
            <if test="query.seriesDescription != null and query.seriesDescription != ''">
                AND series_description = #{query.seriesDescription}
            </if>
            <if test="query.userId != null and query.userId != ''">
                AND user_id = #{query.userId}
            </if>
            <if test="query.sort != null">
                AND sort = #{query.sort}
            </if>
            <if test="query.updateTime != null">
                AND update_time = #{query.updateTime}
            </if>
        </where>
    </update>

    <!-- 按条件动态删除（匹配 query 中有值的字段） -->
    <delete id="deleteByParam" parameterType="map">
        DELETE FROM user_video_series
        <where>
            <if test="query.seriesId != null">
                AND series_id = #{query.seriesId}
            </if>
            <if test="query.seriesName != null and query.seriesName != ''">
                AND series_name = #{query.seriesName}
            </if>
            <if test="query.seriesDescription != null and query.seriesDescription != ''">
                AND series_description = #{query.seriesDescription}
            </if>
            <if test="query.userId != null and query.userId != ''">
                AND user_id = #{query.userId}
            </if>
            <if test="query.sort != null">
                AND sort = #{query.sort}
            </if>
            <if test="query.updateTime != null">
                AND update_time = #{query.updateTime}
            </if>
        </where>
    </delete>

    <update id="changeSort">
        UPDATE user_video_series
        SET sort = CASE
        <foreach collection="videoSeriesList" item="item">
            WHEN user_id = #{item.userId} AND series_id = #{item.seriesId} THEN #{item.sort}
        </foreach>
        END
        WHERE
        <foreach collection="videoSeriesList" item="item" separator="OR">
            (user_id = #{item.userId} AND series_id = #{item.seriesId})
        </foreach>
    </update>

    <resultMap id="base_result_map_video" type="com.pilipala.entity.po.UserVideoSeries" extends="base_result_map">
        <collection property="videoInfoList" column="series_id"
                    select="com.pilipala.mappers.UserVideoSeriesMapper.selectVideoList"></collection>
    </resultMap>

    <select id="selectVideoList" resultType="com.pilipala.entity.po.Video">
        select v.video_id, v.video_name, v.video_cover, v.play_count, v.create_time
        from user_video_series_video as sv
                 inner join video as v on sv.video_id = v.video_id
        where sv.series_id = #{series_id}
        order by sv.sort asc
        limit 5
    </select>

    <select id="selectListWithVideo" resultMap="base_result_map_video">
        select
        <include refid="base_column_list"/>
        from user_video_series
        <include refid="query_condition"/>
        <if test="query.orderBy!=null">order by ${query.orderBy}</if>
        <if test="query.simplePage!=null">limit #{query.simplePage.start},#{query.simplePage.end}</if>
    </select>
</mapper>